{
  "name": "credcheck",
  "version": "1.0.0",
  "description": "A fast, zero-runtime-dependency CLI that scans files or staged git changes for likely-leaked secrets and credentials",
  "keywords": [
    "secrets",
    "credentials",
    "security",
    "cli",
    "pre-commit",
    "secret-scanning",
    "gitleaks"
  ],
  "homepage": "https://github.com/amasen02/credcheck#readme",
  "bugs": "https://github.com/amasen02/credcheck/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amasen02/credcheck.git"
  },
  "license": "MIT",
  "author": "Ama Senevirathne <amasen02@gmail.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "credcheck": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node scripts/run-tests.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.7",
    "eslint": "^9.19.0",
    "globals": "^15.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  }
}
